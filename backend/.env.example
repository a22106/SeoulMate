# === GCP Secret Manager (프로덕션 권장) ===
# 설정 시 아래 시크릿에서 환경변수를 자동 로드. .env 파일 내용보다 우선하지 않음.
# 형식: project_id/secret_name[/version]
# GCP_SECRET_ENV=buoyant-sunbeam-466409-e7/seoulmate-env

# === Vertex AI (Gemini) ===
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=buoyant-sunbeam-466409-e7
GOOGLE_CLOUD_LOCATION=us-central1

# === Google AI Studio (Vertex AI 대신 사용 시) ===
# GEMINI_API_KEY=your_api_key_here

# === Database ===
DATABASE_URL=postgresql://seoulmate:seoulmate_dev@localhost:5432/seoulmate
